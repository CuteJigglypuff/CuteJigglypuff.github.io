{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"\u2726 B-613 \u5c0f\u884c\u661f \u2726 \u4f60\u597d\uff0c\u6b22\u8fce\u6765\u5230 B613 \u5c0f\u884c\u661f \u5411\u4e0b\u63a2\u7d22 \u63a2\u7d22\u5c0f\u884c\u661f \u7b80\u4ecb \u8ba4\u8bc6 B613 \u7684\u4e3b\u4eba \u5173\u4e8e \u8bfe\u7a0b \u5c0f\u884c\u661f\u65e5\u5fd7\u4e0e\u7b14\u8bb0 2 \u7bc7 \u65e5\u5386 \u5f85\u529e\u4e0e\u91cd\u8981\u65e5\u5b50 \u65f6\u95f4\u7ba1\u7406 \u53cb\u94fe \u661f\u9645\u53cb\u90bb \u53cb\u60c5\u94fe\u63a5 \u00b7\u00b7\u00b7 \u672a\u5b8c\u5f85\u7eed \u00b7\u00b7\u00b7  \u66f4\u6362\u80cc\u666f     \u6211\u7684\u56fe\u7247       \u5348\u540e\u8336\u56ed       \u9752\u67e0\u9ea6\u6d6a       \u6a44\u6984\u6696\u9633       \u82a5\u672b\u539f\u91ce       \u8349\u7538\u6668\u96fe"},{"location":"about/","title":"\u7b80\u4ecb","text":"\u5173\u4e8e B613 \u7684\u4e3b\u4eba <p>\u4f60\u597d\uff0c\u6211\u662f\u8fd9\u9897\u5c0f\u884c\u661f\u7684\u552f\u4e00\u5c45\u6c11\u3002\u5728\u8fd9\u91cc\uff0c\u6211\u7167\u6599\u7740\u4e00\u6735\u72ec\u4e00\u65e0\u4e8c\u7684\u73ab\u7470\uff0c\u770b\u7740\u56db\u5341\u4e09\u6b21\u65e5\u843d\u3002\u6b22\u8fce\u4f60\u6765\u6211\u7684\u661f\u7403\u505a\u5ba2\u3002</p>  \u65e5\u5e38\u4e0e\u7231\u597d <p>\u6bcf\u5929\u6e05\u6668\uff0c\u6211\u4f1a\u6e05\u7406\u5c0f\u884c\u661f\u4e0a\u7684\u7334\u9762\u5305\u6811\u5e7c\u82d7\uff0c\u758f\u901a\u4e24\u5ea7\u6d3b\u706b\u5c71\u548c\u4e00\u5ea7\u6b7b\u706b\u5c71\u3002\u7a7a\u95f2\u65f6\uff0c\u6211\u559c\u6b22\u8bfb\u4e66\u3001\u5199\u4f5c\uff0c\u5076\u5c14\u4ef0\u671b\u661f\u7a7a\u53d1\u5446\u3002</p>  \u661f\u9645\u901a\u4fe1 <p>\ud83d\udce7 \u661f\u9645\u90ae\u4ef6\uff1aexample@b613.space</p> <p>\ud83d\udcac \u5982\u679c\u4f60\u5728\u592a\u7a7a\u4e2d\u6536\u5230\u8fd9\u6761\u8baf\u606f\uff0c\u6b22\u8fce\u56de\u4fe1\uff0c\u4e00\u8d77\u804a\u804a\u661f\u661f\u548c\u73ab\u7470\u3002</p> \u00b7\u00b7\u00b7 \u672a\u5b8c\u5f85\u7eed \u00b7\u00b7\u00b7"},{"location":"calendar/","title":"\u65e5\u5386","text":"\u4e0a\u6708 \u65e5\u4e00\u4e8c\u4e09\u56db\u4e94\u516d \u00b7\u00b7\u00b7 \u672a\u5b8c\u5f85\u7eed \u00b7\u00b7\u00b7"},{"location":"calendar/#monthLabel","title":"\u65e5\u5386","text":"\u4e0b\u6708"},{"location":"calendar/#selLabel","title":"\u70b9\u51fb\u65e5\u671f\u67e5\u770b","text":"\u6dfb\u52a0 \ud83c\udf39 \u6807\u8bb0\u4e3a\u91cd\u8981\u65e5\u5b50"},{"location":"course/","title":"\u8bfe\u7a0b","text":"\u8bfe\u7a0b \u00b7 \u5c0f\u884c\u661f\u65e5\u5fd7 <p>\u8bb0\u5f55\u6211\u5728\u661f\u9645\u65c5\u884c\u4e2d\u5b66\u5230\u7684\u79cd\u79cd\u77e5\u8bc6\u3002\u4ece\u4e00\u9897\u661f\u7403\u5230\u53e6\u4e00\u9897\u661f\u7403\uff0c\u6bcf\u4e00\u4e2a\u9047\u89c1\u90fd\u662f\u4e00\u5802\u8bfe\u3002</p> <ul> \u793a\u4f8b\u8bfe\u7a0b\u6587\u6863 \u5165\u95e8 \u66f4\u591a\u661f\u9645\u65e5\u5fd7\u5373\u5c06\u62b5\u8fbe... \u5f85\u7eed </ul> \u00b7\u00b7\u00b7 \u672a\u5b8c\u5f85\u7eed \u00b7\u00b7\u00b7"},{"location":"course/example/","title":"\u793a\u4f8b\u8bfe\u7a0b\u6587\u6863","text":"<p>\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u6587\u6863\uff0c\u4ee5\u540e\u4f60\u53ef\u4ee5\u6309\u7167\u8fd9\u4e2a\u683c\u5f0f\u6765\u5199\u6587\u7ae0\u3002</p>"},{"location":"course/example/#_2","title":"\u6807\u9898\uff08\u4e8c\u7ea7\u6807\u9898\uff09","text":"<p>\u6b63\u6587\u5185\u5bb9\u5199\u5728\u8fd9\u91cc\u3002\u7528 <code>#</code> \u8868\u793a\u6807\u9898\uff0c<code>##</code> \u8868\u793a\u4e8c\u7ea7\u6807\u9898\uff0c<code>###</code> \u8868\u793a\u4e09\u7ea7\u6807\u9898\u3002</p>"},{"location":"course/example/#_3","title":"\u4ee3\u7801\u793a\u4f8b","text":"<pre><code>print(\"Hello, World!\")\n</code></pre>"},{"location":"course/example/#_4","title":"\u5217\u8868","text":"<ul> <li>\u9879\u76ee\u4e00</li> <li>\u9879\u76ee\u4e8c</li> <li>\u9879\u76ee\u4e09</li> </ul>"},{"location":"course/example/#_5","title":"\u5f15\u7528","text":"<p>\u8fd9\u662f\u4e00\u6bb5\u5f15\u7528\u6587\u5b57\u3002</p>"},{"location":"course/example/#_6","title":"\u5f3a\u8c03","text":"<ul> <li>\u7c97\u4f53\u6587\u5b57</li> <li>\u659c\u4f53\u6587\u5b57</li> </ul>"},{"location":"friends/","title":"\u53cb\u94fe","text":"\u53cb\u94fe \u00b7 \u661f\u9645\u53cb\u90bb <p>\u5728\u6d69\u701a\u5b87\u5b99\u4e2d\uff0c\u5076\u5c14\u4f1a\u6536\u5230\u5176\u4ed6\u661f\u7403\u7684\u4fe1\u53f7\u3002\u4ee5\u4e0b\u662f\u6211\u6536\u5230\u7684\u3001\u503c\u5f97\u5206\u4eab\u7684\u661f\u9645\u5750\u6807\u3002</p> <ul> GitHub \u4ee3\u7801\u661f\u4e91 \ud83d\udd17 \u7ef4\u57fa\u767e\u79d1 \u77e5\u8bc6\u661f\u7cfb \ud83d\udd17 \u7b49\u5f85\u65b0\u7684\u661f\u9645\u4fe1\u53f7... \u865a\u4f4d </ul> \u00b7\u00b7\u00b7 \u672a\u5b8c\u5f85\u7eed \u00b7\u00b7\u00b7"}]}